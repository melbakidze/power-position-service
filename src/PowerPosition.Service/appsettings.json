{
  "PowerPosition": {
    "OutputDirectory": "C:\\PowerPosition\\Reports",
    "IntervalMinutes": 5,
    "RetryDelaySeconds": 10,
    "TimeZoneId": "Europe/London"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/PowerPosition-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Properties:j} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
